generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id         String   @id @default(cuid())
  name       String
  email      String
  subject    String?
  service    String?
  message    String
  createdAt  DateTime @default(now())
  ip         String?
}

model ProjectInquiry {
  id             String   @id @default(cuid())
  reference      String   @unique
  name           String
  email          String
  company        String?
  phone          String?
  projectType    String
  title          String
  description    String
  goals          String?
  audience       String?
  features       String?
  existingUrl    String?
  budgetRange    String?
  launchDate     String?
  urgency        String?
  extra          String?
  createdAt      DateTime @default(now())
  ip             String?
}

model Appointment {
  id             String   @id @default(cuid())
  fullName       String
  businessName   String?
  email          String
  phone          String?
  contactMethod  String?
  service        String?
  description    String?
  preferredDate  DateTime
  preferredTime  String
  timeZone       String
  meetingType    String
  notes          String?
  status         String   @default("REQUESTED")
  createdAt      DateTime @default(now())
  ip             String?

  @@unique([preferredDate, preferredTime], name: "date_time_unique")
}
